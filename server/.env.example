# WHAT IF — The Alternate Movie Universe Backend Environment Configuration

# Server & Runtime Environment
PORT=5000
NODE_ENV=production

# Database: MongoDB Atlas Connection URI
# In MongoDB Atlas: Clusters -> Connect -> Drivers -> copy URI
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/whatif_movies?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/whatif_movies?retryWrites=true&w=majority

# Groq API Configuration
# Get your API key from https://console.groq.com/keys
# Recommended Groq production models:
# - llama-3.3-70b-versatile (Recommended high-intelligence model)
# - llama-3.1-8b-instant (Fastest, high rate limit)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Client Origin for CORS
# In production, set to your Vercel frontend URL (or comma-separated URLs):
# Example: https://what-if-movie-game.vercel.app
CLIENT_URL=https://your-frontend-project.vercel.app

# Admin Console Secret Token (used in /admin developer console)
ADMIN_SECRET_KEY=whatif_production_admin_secret_2026

# Embedding Provider: 'local' (built-in semantic vectorizer, no external API needed) | 'openai' | 'huggingface'
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=

# TMDB API Configuration (Optional - seed dataset provides full movie canon)
TMDB_API_KEY=
