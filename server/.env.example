# WHAT IF — The Alternate Movie Universe Environment Configuration

# Server Port
PORT=5000
NODE_ENV=development

# Database (Local MongoDB or MongoDB Atlas URI)
# Defaults to local MongoDB if not set: mongodb://127.0.0.1:27017/whatif_movies
MONGODB_URI=mongodb://127.0.0.1:27017/whatif_movies

# Groq API Configuration
# Get your API key from https://console.groq.com
# Supported models: openai/gpt-oss-120b, qwen/qwen3.8-27b, openai/gpt-oss-20b
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# TMDB API Configuration (Optional - seed dataset provides full movie canon)
# Get your API key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Embedding Provider: 'local' (built-in semantic vectorizer, no API key needed) | 'openai' | 'huggingface'
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=

# Admin Console Secret Token
ADMIN_SECRET_KEY=whatif_dev_admin_secret_2026

# Client URL (for CORS - private LAN IPs like 10.x.x.x, 192.168.x.x are allowed automatically)
CLIENT_URL=http://localhost:5173
