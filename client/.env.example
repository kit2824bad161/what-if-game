# WHAT IF — Client Environment Configuration
#
# Production (Vercel Frontend Project):
# Set VITE_API_URL to your backend deployment URL.
# If using a separate persistent server for multiplayer (e.g., Render/Railway), set VITE_SOCKET_URL.
#
# Example Production Configuration:
# VITE_API_URL=https://what-if-game-server.vercel.app/api
# VITE_SOCKET_URL=https://what-if-game-server.onrender.com
#
# Local Development:
# Leave blank to use Vite's built-in dev proxy (/api -> http://127.0.0.1:5000)

VITE_API_URL=
VITE_SOCKET_URL=
