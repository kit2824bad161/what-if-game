# WHAT IF — Client Environment Configuration (Optional)
# In development, the client automatically infers the backend URL from the browser's hostname:
# - On localhost: connects to http://localhost:5000 (and uses Vite proxy /api)
# - On LAN (e.g. mobile/second laptop): connects to http://<LAN-IP>:5000

# Backend REST API URL (Leave blank to use automatic hostname inference)
# Example for explicit LAN configuration:
# VITE_API_URL=http://10.60.194.125:5000/api
VITE_API_URL=

# Socket.IO Backend URL (Leave blank to use automatic hostname inference)
# Example for explicit LAN configuration:
# VITE_SOCKET_URL=http://10.60.194.125:5000
VITE_SOCKET_URL=
